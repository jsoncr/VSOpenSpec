{
  "name": "openspec-previewer",
  "displayName": "OpenSpec Previewer",
  "description": "%description%",
  "l10n": "./l10n",
  "version": "0.1.0",
  "publisher": "jcruz",
  "author": "jcruz",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsoncr/VSOpenSpec.git"
  },
  "bugs": {
    "url": "https://github.com/jsoncr/VSOpenSpec/issues"
  },
  "homepage": "https://github.com/jsoncr/VSOpenSpec#readme",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "openspec",
    "spec-driven",
    "preview",
    "markdown",
    "tasks"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/openspec/config.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec",
          "title": "OpenSpec",
          "icon": "media/openspec.svg"
        }
      ]
    },
    "views": {
      "openspec": [
        {
          "id": "openspecExplorer",
          "name": "OpenSpec",
          "icon": "media/openspec.svg",
          "contextualTitle": "OpenSpec"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openspecExplorer",
        "contents": "%viewsWelcome.noOpenspec%"
      }
    ],
    "commands": [
      {
        "command": "openspec.refresh",
        "title": "%command.refresh.title%",
        "category": "OpenSpec",
        "icon": "$(refresh)"
      },
      {
        "command": "openspec.preview",
        "title": "%command.preview.title%",
        "category": "OpenSpec",
        "icon": "$(open-preview)"
      },
      {
        "command": "openspec.openSource",
        "title": "%command.openSource.title%",
        "category": "OpenSpec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openspec.collapseAll",
        "title": "%command.collapseAll.title%",
        "category": "OpenSpec",
        "icon": "$(collapse-all)"
      },
      {
        "command": "openspec.runTasks",
        "title": "%command.runTasks.title%",
        "category": "OpenSpec",
        "icon": "$(play)"
      },
      {
        "command": "openspec.archive",
        "title": "%command.archive.title%",
        "category": "OpenSpec",
        "icon": "$(archive)"
      },
      {
        "command": "openspec.closeSpec",
        "title": "%command.closeSpec.title%",
        "category": "OpenSpec",
        "icon": "$(circle-slash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openspec.refresh",
          "when": "view == openspecExplorer",
          "group": "navigation@1"
        },
        {
          "command": "openspec.collapseAll",
          "when": "view == openspecExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "openspec.runTasks",
          "when": "view == openspecExplorer && viewItem == change-runnable",
          "group": "inline@0"
        },
        {
          "command": "openspec.archive",
          "when": "view == openspecExplorer && viewItem == change-archivable",
          "group": "inline@0"
        },
        {
          "command": "openspec.runTasks",
          "when": "view == openspecExplorer && viewItem =~ /^change-/ && viewItem != change-archived",
          "group": "1_actions@1"
        },
        {
          "command": "openspec.archive",
          "when": "view == openspecExplorer && viewItem =~ /^change-/ && viewItem != change-archived",
          "group": "1_actions@2"
        },
        {
          "command": "openspec.closeSpec",
          "when": "view == openspecExplorer && viewItem == file-spec-active",
          "group": "inline@0"
        },
        {
          "command": "openspec.preview",
          "when": "view == openspecExplorer && viewItem =~ /^file/",
          "group": "inline@1"
        },
        {
          "command": "openspec.openSource",
          "when": "view == openspecExplorer && viewItem =~ /^file/",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "OpenSpec Previewer",
      "properties": {
        "openspec.applyCommand": {
          "type": "string",
          "default": "claude \"/openspec:apply ${changeId}\"",
          "markdownDescription": "%config.applyCommand.description%"
        },
        "openspec.archiveCommand": {
          "type": "string",
          "default": "openspec archive ${changeId} -y",
          "markdownDescription": "%config.archiveCommand.description%"
        },
        "openspec.autoRunApply": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoRunApply.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0"
  }
}
